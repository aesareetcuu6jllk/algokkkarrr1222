from JoKeRUB import l313l  # المفروض هذا هو TelegramClient جاهز
from telethon import events, errors
from telethon.tl.functions.channels import InviteToChannelRequest, GetFullChannelRequest, GetParticipantsRequest
from telethon.tl.functions.messages import ImportChatInviteRequest, GetHistoryRequest
from telethon.tl.types import ChannelParticipantsSearch
import os
import asyncio

active_task = None
stop_requested = False

async def fetch_users(group_link, event):
    global active_task, stop_requested
    users_set = set()
    file_path = f"users_{int(asyncio.get_event_loop().time())}.txt"
    stop_requested = False

    if os.path.exists(file_path):
        os.remove(file_path)

    try:
        try:
            group = await l313l.get_entity(group_link)
        except Exception:
            await event.reply("❌ الرابط أو المعرف غير صحيح أو لا يمكن الوصول إلى المجموعة.")
            return

        full_chat = await l313l(GetFullChannelRequest(group))
        total_count = full_chat.full_chat.participants_count

        initial_msg = await event.reply(f"✅ يتم الآن جلب عدد أعضاء المجموعة قبل البدء...")
        await asyncio.sleep(2)
        await initial_msg.edit(f"👥 عدد أعضاء المجموعة: {total_count}\n🔄 جاري بدء السحب...")
        await asyncio.sleep(2)

        extracted_count = 0
        status_msg = await initial_msg.edit(f"🔄 جاري سحب أعضاء المجموعة: {group.title} ...\n0/{total_count}")

        offset = 0
        limit = 100

        while True:
            if stop_requested:
                break

            participants = await l313l(GetParticipantsRequest(
                channel=group,
                filter=ChannelParticipantsSearch(''),
                offset=offset,
                limit=limit,
                hash=0
            ))

            if not participants.users:
                break

            for user in participants.users:
                if stop_requested:
                    break
                username = user.username
                if username and username not in users_set:
                    users_set.add(username)
                    extracted_count += 1
                    with open(file_path, 'a', encoding='utf-8') as f:
                        f.write(f"{username}\n")

            offset += len(participants.users)

            await status_msg.edit(f"🔄 جاري سحب أعضاء المجموعة: {group.title} ...\n{extracted_count}/{total_count}")

        await status_msg.edit(f"✅ تم سحب جميع الأعضاء: {extracted_count}/{total_count}")
        await l313l.send_file('me', file_path, caption="📄 قائمة الأعضاء المستخرجة.")

    except Exception as e:
        await event.reply(f"❌ حدث خطأ: {e}")

    finally:
        active_task = None
        stop_requested = False


async def fetch_messages_usernames(group_link, event, max_messages=1000):
    global active_task, stop_requested
    usernames_set = set()
    file_path = f"usernames_from_messages_{int(asyncio.get_event_loop().time())}.txt"
    stop_requested = False

    if os.path.exists(file_path):
        os.remove(file_path)

    try:
        try:
            group = await l313l.get_entity(group_link)
        except Exception:
            await event.reply("❌ الرابط أو المعرف غير صحيح أو لا يمكن الوصول إلى المجموعة.")
            return

        await event.reply(f"✅ جاري سحب يوزرات من رسائل المجموعة {group.title} (حتى {max_messages} رسالة) ...")

        offset_id = 0
        total_fetched = 0

        while True:
            if stop_requested or total_fetched >= max_messages:
                break

            history = await l313l(GetHistoryRequest(
                peer=group,
                offset_id=offset_id,
                offset_date=None,
                add_offset=0,
                limit=100,
                max_id=0,
                min_id=0,
                hash=0
            ))

            messages = history.messages
            if not messages:
                break

            for message in messages:
                if stop_requested or total_fetched >= max_messages:
                    break
                sender = await message.get_sender()
                if sender and sender.username and sender.username not in usernames_set:
                    usernames_set.add(sender.username)
                    with open(file_path, 'a', encoding='utf-8') as f:
                        f.write(f"{sender.username}\n")
                total_fetched += 1

            offset_id = messages[-1].id

            await event.edit(f"🔄 جاري سحب يوزرات من رسائل المجموعة: {total_fetched}/{max_messages}")

        await event.edit(f"✅ تم الانتهاء من السحب. عدد اليوزرات: {len(usernames_set)}")
        await l313l.send_file('me', file_path, caption="📄 قائمة اليوزرات المستخرجة من رسائل المجموعة.")

    except Exception as e:
        await event.reply(f"❌ حدث خطأ: {e}")

    finally:
        active_task = None
        stop_requested = False


@l313l.on(events.NewMessage(pattern=r'\.اضافة'))
async def add_users_handler(event):

    if not event.reply_to_msg_id:
        await event.respond("❌ لازم ترد على ملف يحتوي على يوزرات المستخدمين!")
        return

    reply_message = await event.get_reply_message()
    if not reply_message.document:
        await event.respond("❌ لازم ترد على ملف نصي يحتوي على يوزرات المستخدمين!")
        return

    try:
        group_link = event.message.text.split(' ')[1]
    except IndexError:
        await event.respond("❌ ارسل الأمر بشكل صحيح:\n.اضافة الرابط \n مثال: .اضافة https://t.me/ft3")
        return

    file_path = await reply_message.download_media()
    status_message = await event.respond("✅ انتظر... جاري الإضافة")

    try:
        try:
            target_group = await l313l.get_entity(group_link)
        except Exception:
            invite_hash = group_link.split('/')[-1]
            target_group = await l313l(ImportChatInviteRequest(invite_hash))

        group_members = await l313l.get_participants(target_group)
        initial_member_count = len(group_members)

        with open(file_path, 'r', encoding='utf-8') as file:
            users = file.read().splitlines()

        total_users = len(users)
        added_count = 0

        await status_message.edit(f"عدد أعضاء المجموعة الحالي: {initial_member_count}\nعدد المستخدمين في الملف: {total_users}/{added_count}")

        for username in users[:]:
            try:
                await l313l(InviteToChannelRequest(target_group, [username]))
                added_count += 1
                users.remove(username)

                with open(file_path, 'w', encoding='utf-8') as file:
                    file.write("\n".join(users))

                group_members = await l313l.get_participants(target_group)
                current_member_count = len(group_members)

                await status_message.edit(f"عدد أعضاء المجموعة الحالي: {current_member_count}\nعدد المستخدمين في الملف: {total_users}/{added_count}")

            except errors.UserPrivacyRestrictedError:
                await event.respond(f"⚠️ ما أقدر أضيف هذا المستخدم @{username} بسبب إعدادات الخصوصية!")
            except errors.FloodWaitError as e:
                await event.respond(f"⏳ تم حظرك مؤقتاً، انتظر {e.seconds} ثانية!")
                break
            except Exception as e:
                await event.respond(f"❌ خطأ غير متوقع: {str(e)}")

            await asyncio.sleep(10)

        os.remove(file_path)
        await event.respond("✅ تم الانتهاء من إضافة المستخدمين")

    except Exception as e:
        await event.respond(f"❌ خطأ في الوصول إلى المجموعة، تأكد من صحة الرابط!\n\n{str(e)}")


@l313l.on(events.NewMessage(chats='me'))
async def command_handler(event):
    global active_task, stop_requested

    msg = event.raw_text.strip()

    if msg.startswith('.سحب'):
        if active_task:
            await event.reply("⚠️ هناك عملية جارية بالفعل! أرسل `.ايقاف` لإيقافها.")
            return

        parts = msg.split()
        if len(parts) < 2:
            await event.reply(
                "❌ الرجاء إرسال الأمر مع الرابط أو المعرف أو ID المجموعة.\n"
                "مثال:\n"
                ".سحب https://t.me/group_link\n"
                ".سحب -1001234567890"
            )
            return

        gp = parts[1]
        active_task = asyncio.create_task(fetch_users(gp, event))

    elif msg.startswith('.يوزرات رسائل'):
        if active_task:
            await event.reply("⚠️ هناك عملية جارية بالفعل! أرسل `.ايقاف` لإيقافها.")
            return

        parts = msg.split()
        if len(parts) < 2:
            await event.reply(
                "❌ الرجاء إرسال الأمر مع الرابط أو المعرف.\n"
                "مثال:\n"
                ".يوزرات رسائل https://t.me/group_link"
            )
            return

        gp = parts[1]
        active_task = asyncio.create_task(fetch_messages_usernames(gp, event, max_messages=1000))

    elif msg == '.ايقاف':
        if active_task:
            stop_requested = True
            await event.reply("🛑 تم إيقاف العملية الجارية. سيتم إرسال الملف بالمستخدمين المستخرجين حتى الآن...")
            await active_task
        else:
            await event.reply("⚠️ لا توجد عملية جارية لإيقافها.")

