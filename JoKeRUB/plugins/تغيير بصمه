
from JoKeRUB import l313l
from telethon import events
from telethon.tl.types import DocumentAttributeAudio
import tempfile, os, subprocess

def _ffmpeg_convert_to_mp3(src, dst):
    subprocess.run(["ffmpeg","-y","-i",src,"-codec:a","libmp3lame","-q:a","4",dst],
                   check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

@l313l.on(events.NewMessage(pattern=r"\.غير البصمه\s+(.+)", outgoing=True))
async def change_vmsg(event):
    title = event.pattern_match.group(1).strip()
    reply = await event.get_reply_message()
    if not reply or not (reply.voice or reply.audio or (reply.document and "audio" in (reply.document.mime_type or ""))):
        return await event.reply("↯ رُد على بصمة/صوت ثم اكتب: `.غير البصمه <الاسم>`")

    # نزّل الملف المؤقت
    in_fd, in_path = tempfile.mkstemp(suffix=".ogg")
    os.close(in_fd)
    await l313l.download_media(reply, file=in_path)

    # حول إلى mp3
    out_path = tempfile.mktemp(suffix=".mp3")
    try:
        _ffmpeg_convert_to_mp3(in_path, out_path)

        # حاول نجيب المدة (إن توفرت) وإلا صفر
        duration = 0
        try:
            for attr in getattr(reply.media, "document", reply.document).attributes:
                if isinstance(attr, DocumentAttributeAudio):
                    duration = attr.duration or 0
                    break
        except Exception:
            pass

        await l313l.send_file(
            entity=event.chat_id,
            file=out_path,
            caption=f"تم ✅ العنوان: {title}",
            attributes=[DocumentAttributeAudio(duration=duration, title=title, performer=None)],
            voice_note=False
        )
    finally:
        for p in (in_path, out_path):
            try:
                if p and os.path.exists(p): os.remove(p)
            except: pass

    try: await event.delete()
    except: pass
